[Unit]
Description=Sync the LAN Arch repository from the archlinux-repo release manifest
Documentation=https://github.com/quantulr/archlinux-repo
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=archrepo
Group=archrepo

# GnuPG keeps its agent sockets in /run/user/<uid>/gnupg. A system service
# does not get a PAM session, so create the runtime and socket directories
# explicitly to make sure they are used instead of the legacy sockets in
# ~/.gnupg.
ExecStartPre=+/bin/sh -c 'uid=$(id -u archrepo); install -d -o archrepo -g archrepo -m 700 /run/user/$uid /run/user/$uid/gnupg'

ExecStart=/usr/bin/arch-repo-update --passphrase-file /etc/arch-repo-update/passphrase
Nice=10
IOSchedulingClass=idle
UMask=0022
TimeoutStartSec=30min

# The repository lives in /srv and the GPG home in /var/lib/archrepo.
# ProtectSystem=full keeps /etc, /usr and /boot read-only while leaving those
# paths writable.
#
# Do not set ProtectHome=read-only: /run/user lives on the /run tmpfs, so it
# would become read-only and gpg-agent could no longer create its sockets.
ProtectSystem=full
PrivateTmp=yes
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
